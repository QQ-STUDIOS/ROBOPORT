  "crews": {
    "jd_crew": {
      "description": "Sequential JD analysis: scout -> technical+compliance (parallel) -> strategist -> synth (+ optional resume_tailor, cover_letter_writer, salary_estimator)",
      "entry": "job_scout",
      "edges": [
        { "from": "job_scout",              "to": "technical_analyst",      "type": "list[Job]" },
        { "from": "job_scout",              "to": "compliance_risk",        "type": "list[Job]" },
        { "from": "technical_analyst",      "to": "application_strategist", "type": "TechnicalAnalysis" },
        { "from": "compliance_risk",        "to": "application_strategist", "type": "ComplianceAnalysis" },
        { "from": "application_strategist", "to": "synthesizer",            "type": "CandidateMatch" },
        { "from": "synthesizer",            "to": "resume_tailor",          "type": "FinalReport", "optional": true },
        { "from": "synthesizer",            "to": "cover_letter_writer",    "type": "FinalReport", "optional": true },
        { "from": "synthesizer",            "to": "salary_estimator",       "type": "FinalReport", "optional": true }
      ]
    },
    "dataops_crew": {
      "description": "Read-only DataOps pipeline: ingest+clean messy tabular data (data_engineering), then produce a templated report grounded in it (reporting). No side effects.",
      "entry": "data_engineering",
      "edges": [
        { "from": "data_engineering", "to": "reporting", "type": "CleanedDataset" }
      ]
    },
    "insight_to_action_crew": {
      "description": "Insight-to-Action: clean data (data_engineering) -> grounded report (reporting) -> PROPOSE side-effecting actions (automation). The terminal automation station exercises the Phase-3 Layer-3 unsafe-action escalation in a real crew: every irreversible or outward-facing action is proposed with requires_approval, audited, and escalated to a human — never executed. Offline; side effects are represented via policy/escalation, not performed.",
      "entry": "data_engineering",
      "edges": [
        { "from": "data_engineering", "to": "reporting",  "type": "CleanedDataset" },
        { "from": "reporting",         "to": "automation", "type": "DataReport" }
      ]
    },
    "brightree_rounds_crew": {
      "description": "Offline MODEL of the Theragen Brightree->Rounds workflow: brightree_pdf_extraction extracts structured records from source PDFs (PHI columns named, never carried), then reporting produces the Rounds report grounded in them. Read-only; PHI-classified. ROBOPORT never touches real Brightree or Snowflake — the run is proven against a synthetic fixture.",
      "classification": "PHI",
      "entry": "theragen_brightree_pdf_extraction",
      "edges": [
        { "from": "theragen_brightree_pdf_extraction", "to": "reporting", "type": "ExtractedRecords" }
      ]
    },
    "tenant_scan_crew": {
      "description": "Offline MODEL of the Theragen Tenant-Scan workflow: tenant_scan takes a read-only inventory of Microsoft 365 sites (metadata only), then reporting produces a legacy-site disposition report grounded in it. Read-only; Confidential. ROBOPORT never calls Microsoft Graph — proven against a synthetic inventory fixture.",
      "classification": "Confidential",
      "entry": "theragen_tenant_scan",
      "edges": [
        { "from": "theragen_tenant_scan", "to": "reporting", "type": "SiteInventory" }
      ]
    }
  },
